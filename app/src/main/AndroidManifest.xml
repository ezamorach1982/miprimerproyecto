<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Requerido para que la app aparezca en el catálogo/lanzador de Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".FunTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FunTV.Login"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic + network_security_config: muchos paneles Xtream Codes
          se sirven por HTTP plano en puertos no estándar (sin TLS). Se permite tráfico
          en claro globalmente porque el propio usuario introduce el servidor en tiempo
          de ejecución (no se conoce el host en tiempo de compilación).
        -->

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FunTV.Login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FunTV.Browse" />

        <activity
            android:name=".ui.browse.SectionBrowseActivity"
            android:exported="false"
            android:theme="@style/Theme.FunTV.Browse" />

        <activity
            android:name=".ui.details.SeriesDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.FunTV.Browse" />

        <activity
            android:name=".ui.player.PlaybackActivity"
            android:exported="false"
            android:theme="@style/Theme.FunTV.Player"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

    </application>

</manifest>
