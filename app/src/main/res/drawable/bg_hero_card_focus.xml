<?xml version="1.0" encoding="utf-8"?>
<!-- Marco de foco para las tarjetas grandes del inicio: nada visible en reposo (la foto
     de fondo ya es el contenido principal), un anillo de acento al enfocar con D-pad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="@color/funtv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
