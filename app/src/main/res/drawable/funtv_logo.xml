<?xml version="1.0" encoding="utf-8"?>
<!-- Marca FunTV: recreación vectorial del logo (4 figuras tipo "paisley" en
     pinwheel alrededor de un centro con 4 puntos, uno por color de marca). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Amarillo, apunta hacia arriba -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path
            android:fillColor="@color/funtv_yellow"
            android:pathData="M47,33 L61,33 L58,54 L50,54 Z
                               M54,7 A13,13 0 1,0 54,33 A13,13 0 1,0 54,7 Z" />
    </group>

    <!-- Azul, apunta hacia la derecha -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path
            android:fillColor="@color/funtv_blue"
            android:pathData="M47,33 L61,33 L58,54 L50,54 Z
                               M54,7 A13,13 0 1,0 54,33 A13,13 0 1,0 54,7 Z" />
    </group>

    <!-- Verde, apunta hacia abajo -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path
            android:fillColor="@color/funtv_green"
            android:pathData="M47,33 L61,33 L58,54 L50,54 Z
                               M54,7 A13,13 0 1,0 54,33 A13,13 0 1,0 54,7 Z" />
    </group>

    <!-- Rojo, apunta hacia la izquierda -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path
            android:fillColor="@color/funtv_red"
            android:pathData="M47,33 L61,33 L58,54 L50,54 Z
                               M54,7 A13,13 0 1,0 54,33 A13,13 0 1,0 54,7 Z" />
    </group>

    <!-- Centro: 4 puntitos, uno por color, donde se juntan las 4 figuras -->
    <path
        android:fillColor="@color/funtv_yellow"
        android:pathData="M48.5,51 A2.5,2.5 0 1,0 53.5,51 A2.5,2.5 0 1,0 48.5,51 Z" />
    <path
        android:fillColor="@color/funtv_blue"
        android:pathData="M54.5,51 A2.5,2.5 0 1,0 59.5,51 A2.5,2.5 0 1,0 54.5,51 Z" />
    <path
        android:fillColor="@color/funtv_red"
        android:pathData="M48.5,57 A2.5,2.5 0 1,0 53.5,57 A2.5,2.5 0 1,0 48.5,57 Z" />
    <path
        android:fillColor="@color/funtv_green"
        android:pathData="M54.5,57 A2.5,2.5 0 1,0 59.5,57 A2.5,2.5 0 1,0 54.5,57 Z" />

</vector>
