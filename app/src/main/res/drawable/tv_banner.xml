<?xml version="1.0" encoding="utf-8"?>
<!-- Banner del lanzador de Android TV (320x180dp). Incluye la marca gráfica de
     FunTV; el nombre de la app lo superpone el propio lanzador de TV usando
     android:label, ya que los vector drawables no pueden dibujar texto. -->
