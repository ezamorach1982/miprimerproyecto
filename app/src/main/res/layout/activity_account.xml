<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funtv_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        android:src="@drawable/funtv_logo" />

    <TextView
        android:id="@+id/textAccountServer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@color/funtv_text_primary"
        android:textSize="18sp"
        tools:text="http://midominio.com:8080" />

    <TextView
        android:id="@+id/textAccountUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/funtv_text_secondary"
        android:textSize="14sp"
        tools:text="Usuario: miusuario" />

    <TextView
        android:id="@+id/textAccountExpiration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/funtv_accent"
        android:textSize="14sp"
        tools:text="Tu cuenta vence el 31/12/2026" />

    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/funtv_error"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:text="@string/action_logout"
        android:textColor="@color/funtv_text_primary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textColor="@color/funtv_text_secondary"
        android:textSize="12sp"
        tools:text="FunTV Player 1.0.0" />

</LinearLayout>
