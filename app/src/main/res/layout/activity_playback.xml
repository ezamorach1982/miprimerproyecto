<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Se usan los controles por defecto de Media3 (play/pausa, retroceder/avanzar,
         barra de progreso, calidad/audio vía el ícono de ajustes): ya son navegables
         con D-pad de forma nativa. show_subtitle_button agrega el botón de
         subtítulos/CC, que Media3 oculta por defecto. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="always"
        app:show_subtitle_button="true"
        app:use_controller="true" />

    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/funtv_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/funtv_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textPlaybackError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/funtv_text_primary"
            android:textSize="16sp"
            tools:text="@string/player_retry_exhausted" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonManualRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:backgroundTint="@color/funtv_accent"
                android:text="@string/player_manual_retry"
                android:textColor="@color/funtv_background" />

            <Button
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_back"
                android:textColor="@color/funtv_text_primary" />

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
