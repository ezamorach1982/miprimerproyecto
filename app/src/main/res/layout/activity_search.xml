<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funtv_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">

        <EditText
            android:id="@+id/editSearchQuery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusDown="@id/buttonSearchGo"
            android:nextFocusRight="@id/buttonSearchGo"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/funtv_text_primary"
            android:textColorHint="@color/funtv_text_secondary" />

        <Button
            android:id="@+id/buttonSearchGo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/funtv_accent"
            android:nextFocusUp="@id/editSearchQuery"
            android:nextFocusLeft="@id/editSearchQuery"
            android:text="@string/search_button"
            android:textColor="@color/funtv_background"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/searchResultsContainer"
        android:name="com.funtv.player.ui.search.SearchResultsFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
