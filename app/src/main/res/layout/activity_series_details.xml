<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funtv_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="32dp">

        <ImageView
            android:id="@+id/imageCover"
            android:layout_width="180dp"
            android:layout_height="260dp"
            android:background="@drawable/placeholder_poster"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textSeriesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/funtv_text_primary"
                android:textSize="26sp"
                tools:text="Nombre de la serie" />

            <TextView
                android:id="@+id/textSeriesMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/funtv_accent"
                android:textSize="14sp"
                tools:text="2023 · Drama · ★ 8.5" />

            <TextView
                android:id="@+id/textSeriesPlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="5"
                android:ellipsize="end"
                android:textColor="@color/funtv_text_secondary"
                android:textSize="14sp"
                tools:text="Sinopsis de la serie con una descripción breve del argumento principal." />

            <TextView
                android:id="@+id/textSeriesCast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/funtv_text_secondary"
                android:textSize="13sp"
                tools:text="Reparto: Actor uno, Actor dos" />

        </LinearLayout>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/seasonsFragmentContainer"
        android:name="com.funtv.player.ui.details.SeasonsRowsFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
