<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/funtv_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/funtv_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/home_title"
            android:textColor="@color/funtv_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textClock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:textColor="@color/funtv_text_secondary"
            android:textSize="14sp"
            tools:text="14:32 · lun. 15 sep."
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageButton
            android:id="@+id/buttonHomeSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sidebar_item"
            android:contentDescription="@string/home_search_desc"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="10dp"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/buttonHomeRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sidebar_item"
            android:contentDescription="@string/home_refresh_desc"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="10dp"
            android:src="@drawable/ic_refresh_small" />

        <ImageButton
            android:id="@+id/buttonHomeAccount"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sidebar_item"
            android:contentDescription="@string/home_account_desc"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="10dp"
            android:src="@drawable/ic_account_small" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/rowsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/funtv_surface"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/textHomeExpiration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/funtv_text_secondary"
            android:textSize="12sp"
            tools:text="Vence: 31/12/2026"
            xmlns:tools="http://schemas.android.com/tools" />

        <TextView
            android:id="@+id/textHomeUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/funtv_text_secondary"
            android:textSize="12sp"
            tools:text="Usuario: miusuario"
            xmlns:tools="http://schemas.android.com/tools" />

    </LinearLayout>

</LinearLayout>
